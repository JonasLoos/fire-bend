def Math
    public def fib(n)
        if n <= 1
            return 1
        else
            # bare name and self. are the same call (public = local binding)
            return fib(n - 1) + self.fib(n - 2)

    public fib2 = n => if n <= 1 do 1 else fib2(n - 1) + fib2(n - 2)


print(Math.fib(6))   # 13
print(Math.fib2(10)) # 89

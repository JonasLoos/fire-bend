# any/all/count/find with a callback that may fail: the failure is the
# program's, and any/all/find stop at the first decisive element
def is_rect(m)
    len(m) > 0 and m.all(r => len(r) == len(m[0]))

xs = [0, 1]
ys = [5, 1]
print(is_rect([[1, 2], [3, 4]]), is_rect([[1], [3, 4]]))
print(xs.all(i => ys[i] > 0), xs.all(i => ys[i] > 3))
print(xs.any(i => ys[i] > 3), xs.any(i => ys[i] > 9))
print(xs.any(i => ys[i + i] > 3))
print(xs.count(i => ys[i] > 0), xs.find(i => ys[i] < 3), xs.find(i => ys[i] > 9))

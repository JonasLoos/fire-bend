# writes through several indexes and members: the element is written back
var rows = [[1, 2], [3, 4]]
rows[1][0] = 9
rows[0][1] += 5
print(rows)
def with_cell(g, r, c, v)
    g[r][c] = v
    g
print(with_cell([['.', '.'], ['.', '.']], 1, 1, 'x'))
d = {}
d["a"] = [1]
d["a"][0] = 7
d["a"].push(8)
print(d)
# a record's fields may be assigned; the record is a value
recs = [{a: 1}, {a: 2}]
recs[1].a = 5
p = {x: 1, y: 2}
p.x = 10
print(recs, p)
def Board
    public var rows = [[0, 0], [0, 0]]
    public put = (r, c, v) => rows[r][c] = v
var b = Board()
b.put(1, 1, 3)
print(b.rows)
cube = [[[0]]]
cube[0][0][0] = 1
print(cube)

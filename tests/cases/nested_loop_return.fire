# a return from an inner loop leaves every loop and the def
def find_pair(xs, target)
    for a in xs
        for b in xs
            if a + b == target do return [a, b]
    []

def first_even(xs)
    for x in xs
        if x % 2 == 0 do return x
    nothing

print(find_pair([1, 2, 3, 4], 7), find_pair([1, 2], 10))
print(first_even([1, 3, 4, 5]), first_even([1, 3]))

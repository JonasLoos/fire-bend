# recursion that shrinks the first argument, or keeps it and shrinks the
# second: accepted as terminating (lexicographic descent)
def merge(a, b)
    match a
        [] => b
        [x, ...xs] =>
            match b
                [] => a
                [y, ...ys] => if x <= y do [x] + merge(xs, b) else [y] + merge(a, ys)

print(merge([1, 4, 9], [2, 3, 10]), merge([], [5]), merge(["b"], ["a", "c"]))

# results, railway per element, maybe values, nested loops, break/return
def safe_div(a, b)
    if b == 0 do {err: "division by zero"} else {ok: a / b}

print(safe_div(10, 2))
print(safe_div(1, 0))
r = safe_div(10, 2) |> $ + 1 !> err => -1
print(r)
r2 = safe_div(1, 0) |> $ + 1 !> err => -1
print(r2)
vals = ["1", "2", "oops", "4"] *> $.parse_int() *> $ * 10 !> -1
print(vals)

def find_first_even(xs)
    for x in xs
        if x % 2 == 0 do return x
    nothing

print(find_first_even([1, 3, 4, 5]))
print(find_first_even([1, 3]))
match find_first_even([7, 8])
    nothing => print("none")
    n => print("found {n}")

def has_pair(xs, target)
    for a in xs
        for b in xs
            if a + b == target do return true
    false
print(has_pair([1, 2, 3], 5), has_pair([1, 2, 3], 10))

var n = 0
for _ in 0..10
    n += 1
    if n > 5 do break
print(n)

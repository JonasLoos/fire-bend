# inheritance, comprehensions, pipelines, custom operators
def Animal(public name: str, public sound: str = '...')
    public speak = () => "{name} the Animal says {sound}"

def Dog(name: str = "Doggy", public breed: str = "Unknown")
    parent = Animal(name, "Woof")
    self.{...} = parent
    public speak = () => "{name} the {breed} Dog says {sound}"

print(Animal("Thing").speak())
print(Dog("Buddy", "Golden").speak())
d = Dog()
print(d.name, d.sound, d.breed)

def fib(n)
    if n <= 1 do n else fib(n - 1) + fib(n - 2)

print(fib(10))

squares = for x in 1..6 do x * x
print(squares)
evens = for x in 1..11 do if x % 2 == 0 do x
print(evens)

def is_prime(n)
    if n < 2 do return false
    for d in 2..n
        if n % d == 0 do return false
    true

primes = 2..50 ?> is_prime
print(primes.take(8))
print(1..10 *> $ * $ |> $.take(4))

def Vec2(public x: float = 0.0, public y: float = 0.0)
    public `+` = other => Vec2(x + other.x, y + other.y)
    public `*` = k => Vec2(x * k, y * k)
    public len = () => $math.sqrt(x * x + y * y)

v = Vec2(3.0, 4.0) + Vec2(1.0, 2.0)
print(v, (v * 2.0).len())

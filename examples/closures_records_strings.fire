# closures with captures, records, dicts, strings, sorting
factor = 3
scaled = [1, 2, 3] *> $ * factor
print(scaled)

def make_adder(k)
    x => x + k

add5 = make_adder(5)
print(add5(10))
print([1, 2] *> add5)

people = [{name: "ada", age: 36}, {name: "bob", age: 17}, {name: "cy", age: 50}]
adults = people ?> $.age >= 18 *> $.name
print(adults)
print(sorted(people, p => p.age) *> $.name)
oldest = people.reduce((a, b) => if a.age > b.age do a else b)
print(oldest.name)

counts = {}
for w in "a b a c b a".split(" ")
    counts[w] = (counts[w] or 0) + 1
print(counts["a"], counts["b"], counts["z"])
print(counts.keys())

s = "Hello, World"
print(s.upper(), s.lower(), len(s), s[0], s[-1], s[0..5])
print(s.split(", ").join(" | "))
print("{s:>15}|{s:<15}|{3.14159:.2f}|{42:5}")
print(s.contains("World"), s.starts_with("He"), s.index_of("World"))

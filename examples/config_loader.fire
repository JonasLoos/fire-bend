# Nested configuration objects. A closed set of choices is a declared type:
# a `match` on it must name every constructor (or have a catch-all).
type LogLevel
    Silent
    Normal
    Verbose

def level_name(level: LogLevel)
    match level
        Silent => "silent"
        Normal => "normal"
        Verbose => "verbose"

def DatabaseConfig(public host: str, public port: int = 5432)
    public connection_string = () => "db://{host}:{port}"

def AppConfig(app_name: str)
    public name = app_name
    public var log_level = Normal
    public db = DatabaseConfig("localhost")

    public set_log_level = (level: LogLevel) =>
        log_level = level

    public summary = () =>
        "App '{name}' logging at {level_name(log_level)}, DB: {db.connection_string()}"


app_config = AppConfig("MyWebApp")
print(app_config.summary())

app_config.set_log_level(Verbose)
print(app_config.summary())

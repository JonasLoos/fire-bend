# Lazy streams: pipelines over open-ended ranges compute nothing until a
# finite prefix is consumed.

# an infinite pipeline, described but not run
def is_prime(n)
    if n < 2
        return false
    for d in 2..n
        if n % d == 0
            return false
    true

primes = 2.. ?> is_prime

# .take(n) pulls exactly n items through the pending stages
print(primes.take(10))

# streams compose: drop a prefix, keep going
print(primes.drop(10).take(5))

# map stages are lazy too
print(1.. *> $ * $ |> $.take(6))

# for-loops pull items one at a time, so break makes them finite
var total = 0
var last = 0
for n in 1..
    total += n
    last = n
    if total > 100
        break
print("1+2+...+{last} = {total}")

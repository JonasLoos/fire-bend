def Animal(public name: str, public sound: str = '...')
    public speak = () => "{name} the Animal says {sound}"

def Dog(name: str = "Doggy", public breed: str = "Unknown")
    parent = Animal(name, "Woof")  # inherit and set sound
    self.{...} = parent
    public speak = () => "{name} the {breed} Dog says {sound}"

def Poodle(name: str = "Fifi")
    parent = Dog(name, "Poodle")
    self.{...} = parent
    public speak = () => "{name} the {breed} says {sound} elegantly!"

# --- Usage ---
generic_animal = Animal("Thing")
print(generic_animal.speak())  # "Thing the Animal says ..."

buddy = Dog("Buddy", "Golden Retriever")
print(buddy.speak())  # "Buddy the Golden Retriever Dog says Woof"

default_dog = Dog()
print(default_dog.speak())  # "Doggy the Unknown Dog says Woof"

fifi = Poodle()
print(fifi.speak())  # "Fifi the Poodle says Woof elegantly!"

def Vector2D(public x: float = 0.0, public y: float = 0.0)

    # custom operators: a public member named for the operator symbol;
    # `v + w` dispatches on the left operand
    public `+` = (other: Vector2D) => Vector2D(x + other.x, y + other.y)
    public `-` = (other: Vector2D) => Vector2D(x - other.x, y - other.y)
    public `*` = (factor: float) => Vector2D(x * factor, y * factor)

    ## Calculate magnitude (length)
    public magnitude = () => (x * x + y * y)**0.5

    public to_string = () => "Vector2D(x={x}, y={y})"


v1 = Vector2D(3.0, 4.0)
v2 = Vector2D(1.0, 2.0)

print((v1 + v2).to_string())    # Vector2D(x=4.0, y=6.0)
print((v1 - v2).to_string())    # Vector2D(x=2.0, y=2.0)
print(v1.magnitude())           # 5.0
print((v1 * 2.0).to_string())   # Vector2D(x=6.0, y=8.0)

# Custom operators on a Money class and a Vec class, helper defs over lists
# of objects, structural `==` on objects, `sorted` by key on lists of
# objects, and `print` of objects.
def Money(public cents: int = 0)
    public `+` = other => Money(cents + other.cents)
    public `-` = other => Money(cents - other.cents)
    public `*` = k => Money(cents * k)
    public negative = () => cents < 0
    public show = () => "{((cents - cents % 100) / 100)}.{(cents % 100):02d}"

def Vec(public x: int = 0, public y: int = 0)
    public `+` = other => Vec(x + other.x, y + other.y)
    public `-` = other => Vec(x - other.x, y - other.y)
    public `*` = k => Vec(x * k, y * k)
    public dot = other => x * other.x + y * other.y

def LineItem(public sku: str, public price: Money, public qty: int)
    public total = () => price * qty

def sum_money(items)
    var acc = Money(0)
    for it in items do acc = acc + it.total()
    acc

def cheapest(items)
    sorted(items, it => it.price.cents)[0]

def by_sku(items)
    sorted(items, it => it.sku)

def centroid(points)
    var acc = Vec(0, 0)
    for p in points do acc = acc + p
    Vec(acc.x / len(points), acc.y / len(points))

def discount(m, pct)
    m - Money(m.cents * pct / 100)

cart = [
    LineItem("pear", Money(150), 4),
    LineItem("fig", Money(325), 2),
    LineItem("apple", Money(99), 10),
]
total = sum_money(cart)
print(total.show(), total.cents, Money(105).show(), Money(7).show())
print(cheapest(cart).sku, by_sku(cart) *> $.sku)
print(discount(total, 10).show())
print(cart *> $.total().cents)
print(sorted(cart, it => -it.total().cents) *> $.sku)

# structural equality on objects, records, and nested objects
print(Money(100) == Money(100), Money(100) == Money(101))
print(LineItem("a", Money(1), 1) == LineItem("a", Money(1), 1))
print(LineItem("a", Money(1), 1) == LineItem("a", Money(2), 1))
print(Vec(1, 2) == Vec(1, 2), Vec(1, 2) == Vec(2, 1))
print(Vec(1, 2) + Vec(3, 4) == Vec(4, 6))
print((Money(5) * 3 - Money(1)).cents, (Money(1) - Money(5)).negative())

# vectors: operators, dot product, centroid
pts = [Vec(0, 0), Vec(4, 0), Vec(4, 8), Vec(0, 8)]
c = centroid(pts)
print(c, c.dot(Vec(1, 1)))
print(pts *> $ - c)
print(pts *> $.dot(Vec(1, 2)) |> sum)

# printing objects
print(Money(250))
print(cart[1])
print(cart[0].price == Money(150), cart[0].price)

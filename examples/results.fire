# Failure as values. A lookup that can miss answers `T | nothing`; an
# operation that can fail answers a result, `{ok: v}` or `{err: e}`.
# Pipelines unwrap an `ok` into the next stage and pass an `err` along,
# and `!>` recovers from it.

def safe_div(a, b)
    if b == 0 do {err: "division by zero"} else {ok: a / b}

print(safe_div(10, 2), safe_div(1, 0))
print(safe_div(10, 2) |> $ + 1 !> -1)
print(safe_div(1, 0) |> $ + 1 !> -1)
print(safe_div(1, 0) |> "{$}" !> err => "failed: {err}")

# over a list of results the railway runs per element
print(["1", "2", "oops", "4"] *> $.parse_int() *> $ * 10 !> -1)

match "7".parse_int()
    {ok} => print("parsed {ok}")
    {err} => print("failed: {err}")

# `nothing` on one path and a value on another make a `T | nothing`
def first_even(xs)
    for x in xs
        if x % 2 == 0 do return x
    nothing

print(first_even([1, 3, 4, 5]), first_even([1, 3]))
match first_even([7, 8])
    nothing => print("none")
    n => print("found {n}")
print(first_even([1]) or 0)        # `or` gives a default

# match: literals, list shapes, guards, and a catch-all
def describe(p)
    match p
        [0, 0] => "origin"
        [x, 0] if x > 0 => "positive x axis"
        [x, 0] => "x axis at {x}"
        [0, y] => "y axis at {y}"
        [x, y] => "point {x},{y}"
        other => "something else"

for p in [[0, 0], [3, 0], [-3, 0], [0, 7], [1, 2], [1, 2, 3]]
    print(describe(p))

# an arm may leave: here it skips the rest of the loop body
var total = 0
for s in ["4", "x", "5"]
    n = match s.parse_int()
        {ok} => ok
        {err} => continue
    total += n
print(total)

# Recursion on ints: every def here is total, and Bend's checker agrees.
# A self-call on `n - 1` (or `n - 2`) is accepted under a guard that keeps
# `n` from going below zero (`if n <= 1`), so recursion always ends.

def fib(n: int)
    if n <= 1
        1
    else
        fib(n - 1) + fib(n - 2)

def fact(n: int)
    if n <= 0
        1
    else
        n * fact(n - 1)

# the same numbers by a loop: a `for` over a range always ends
def fib_loop(n: int)
    var a = 1
    var b = 1
    for _ in 0..n
        next = a + b
        a = b
        b = next
    a

print(fib(6))   # 13
print(fact(5))  # 120
print(fib_loop(6), fib_loop(30))
print(for i in 0..10 do fib(i))

def Counter(initial_value: int = 0)
    # private state: a closure variable, invisible from outside
    var count = initial_value

    ## Increment the counter by 1
    public increment = () => count += 1

    ## Decrement the counter by 1
    public decrement = () => count -= 1

    ## Reset the counter to its initial value
    public reset = () => count = initial_value

    ## Get the current count
    public get_count = () => count

    return self


c1 = Counter()      # starts at 0
c1.increment()
c1.increment()
c1.decrement()
print(c1.get_count())  # 1

c2 = Counter(10)    # starts at 10
c2.decrement()
print(c2.get_count())  # 9
c2.reset()
print(c2.get_count())  # 10
